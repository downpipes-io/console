# legacy-peer-deps is required because madge@8 declares peerOptional typescript@^5.4.4
# while this repo pins a newer typescript (5.9.x); without the flag `npm ci` fails with
# an ERESOLVE conflict. The production tree (the @noble crypto family) has no peer
# conflicts; this only affects the dev tooling. Re-check on the next madge major.
legacy-peer-deps=true
